{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean Directories",
            "type":"shell",
            "command":"rmdir",
            "args": [
            "/s", 
            "/q", 
            "build"
            ],
            "windows": {
            "command": "cmd",
            "args": ["/c", "if exist build rmdir /s /q build"]
            },
        }, 
        {
            "label": "Compile Module",
            "type": "shell",
            "command":"javac",
            "args": [
                "--module-source-path", "src",
                "-d", "build/classes", 
                "--module", "pet",
                "-proc:none",
                "-Xlint:deprecation"
            ],
            "group": "build",
            "presentation":{
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "showReuseMessage": true,
                "clear": true   
            }
        },
        {
            "label": "Package Module",
            "type":"shell",
            "command":"jar",
            "args": [
                "--create",
                "--file", "build/jars/pet.jar",
                "-C", "build/classes/pet", "."
            ],
            "group":"build",
            "presentation":{
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "showReuseMessage": true,
                "clear": false   
            }
        }, 
        {
            "label": "Compile Tests",
            "type":"shell",
            "command": "cmd",
            "args": [
                "/c",
                "javac -cp \"lib/*;build/classes/pet\" -d build/test-classes src/test/com/blendwerk/pet/domain/*.java"
            ],
            "group":"build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "showReuseMessage": true,
                "clear": true  
            }       
        },
        {
            "label": "Build Solution",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Directories",
                "Compile Module",
                "Package Module",
                "Compile Tests"
            ],
            "group": {
                "kind":"build",
                "isDefault": true
            }, 
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }, 
        {
            "label":"Test PET Module",
            "type":"shell",
            "command":"cmd",
            "args": [
                "/c",
                "java -jar lib/junit-platform-console-standalone-1.10.0.jar -cp \"lib/junit-platform-console-standalone-1.10.0.jar;build/classes/pet;build/test-classes\" --scan-classpath"
            ],
            "group":"test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true,
                "showReuseMessage": true,
                "panel":"dedicated"
            },
            "dependsOn":"Compile Tests"
        }
    ]
}